@using Core.DTOs
@model SetDetailDTO

@{
    ViewData["Title"] = "Редактор карток - " + Model.Name;
    // Тимчасова заглушка для перевірки власника (потім заміниш на логіку авторизації)
    var currentUserName = "Admin";
    bool isOwner = Model.UserName == currentUserName;
}

<style>
    /* --- ОСНОВНІ СТИЛІ --- */
    .back-link {
        color: var(--accent-color);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
        opacity: 0.7;
        text-decoration: none;
        transition: 0.3s;
        font-size: 0.9rem;
    }

        .back-link:hover {
            opacity: 1;
            transform: translateX(-5px);
        }

    .header-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 30px;
        gap: 20px;
    }

    /* --- КАТЕГОРІЇ (ТЕГИ) --- */
    .categories-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 12px;
        padding: 0;
        list-style: none;
    }

    .category-badge {
        display: inline-flex;
        align-items: center;
        background: rgba(119, 158, 203, 0.2);
        border: 1px solid #779ECB;
        color: #DEE4C7;
        padding: 6px 12px;
        border-radius: 12px;
        font-size: 0.85rem;
        gap: 8px;
    }

    .cat-edit-btn {
        background: none;
        border: none;
        color: white;
        cursor: pointer;
        opacity: 0.6;
        font-size: 0.8rem;
        padding: 0;
    }

    .remove-cat-btn {
        background: none;
        border: none;
        color: #ff8080;
        cursor: pointer;
        font-weight: bold;
        font-size: 1.1rem;
        line-height: 1;
        padding: 0;
    }

    /* --- СІТКА КАРТОК --- */
    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 25px;
    }

    .flashcard-item {
        background-color: var(--btn-bg);
        border: 1px solid var(--btn-border);
        border-radius: 15px;
        padding: 25px;
        min-height: 160px;
        display: flex;
        flex-direction: column;
        position: relative;
        transition: all 0.3s ease;
    }

        .flashcard-item:hover {
            border-color: var(--accent-color);
            background-color: var(--btn-hover);
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.4);
        }

    .card-term {
        font-weight: bold;
        color: var(--accent-color);
        font-size: 1.15rem;
        margin-bottom: 12px;
        padding-right: 25px;
        word-wrap: break-word;
    }

    .card-divider {
        height: 1px;
        background: rgba(240, 255, 255, 0.1);
        border: none;
        margin: 10px 0;
    }

    .card-definition {
        opacity: 0.8;
        font-size: 1rem;
        line-height: 1.4;
        word-wrap: break-word;
    }

    .card-update-info {
        margin-top: auto;
        padding-top: 10px;
        text-align: right;
        border-top: 1px solid rgba(240, 255, 255, 0.05);
    }

    /* --- МЕНЮ ТА МОДАЛКИ --- */
    .dots {
        position: absolute;
        top: 15px;
        right: 15px;
        cursor: pointer;
        font-size: 1.5rem;
        opacity: 0.5;
        z-index: 10;
        line-height: 1;
    }

    .dropdown {
        position: absolute;
        top: 45px;
        right: 15px;
        background: #2C3440;
        border: 1px solid #818375;
        border-radius: 8px;
        display: none;
        flex-direction: column;
        z-index: 100;
        box-shadow: 0 8px 25px rgba(0,0,0,0.6);
        overflow: hidden;
    }

        .dropdown button {
            background: none;
            border: none;
            color: white;
            padding: 12px 20px;
            text-align: left;
            cursor: pointer;
            width: 100%;
            font-size: 0.9rem;
        }

            .dropdown button:hover {
                background-color: #6B8789;
            }

    .btn-main {
        background: #6B8789;
        color: white;
        border: none;
        padding: 12px 20px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: bold;
        transition: 0.3s;
        white-space: nowrap;
    }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.85);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 2000;
    }

    .modal {
        background: #1C2531;
        border: 1px solid var(--accent-color);
        padding: 30px;
        border-radius: 15px;
        width: 420px;
        max-width: 90%;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

        .modal input, .modal textarea, .modal select {
            background: #141B25;
            border: 1px solid #818375;
            color: white;
            padding: 12px;
            border-radius: 8px;
            outline: none;
            font-family: inherit;
            width: 100%;
            box-sizing: border-box;
        }

    .category-select-list {
        max-height: 180px;
        overflow-y: auto;
        background: #141B25;
        border: 1px solid #818375;
        border-radius: 8px;
        margin: 10px 0;
    }

    .category-option {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        cursor: pointer;
    }

        .category-option:hover {
            background: rgba(255,255,255,0.05);
        }
</style>

<div class="content-area">
    <a asp-controller="MySets" asp-action="Index" class="back-link">← Назад до моїх сетів</a>

    <div class="header-row">
        <div>
            <h2 style="color: var(--accent-color); margin: 0; font-size: 1.8rem;">@Model.Name</h2>
            <p style="opacity: 0.6; margin: 5px 0 0 0;">@Model.Description</p>

            <ul class="categories-list">
                @foreach (var cat in Model.Categories)
                {
                    <li class="category-badge">
                        @cat.Name
                        @if (isOwner)
                        {
                            <div style="display:flex; gap:5px;">
                                <button type="button" class="cat-edit-btn" onclick="openEditCategoryModal('@cat.Id', '@cat.Name')">✎</button>
                                <form asp-controller="Details" asp-action="RemoveCategory" method="post" style="display:inline;">
                                    <input type="hidden" name="setId" value="@Model.Id" />
                                    <input type="hidden" name="categoryId" value="@cat.Id" />
                                    <button type="submit" class="remove-cat-btn" title="Прибрати" onclick="return confirm('Прибрати категорію з цього сету?')">×</button>
                                </form>
                            </div>
                        }
                    </li>
                }
            </ul>
        </div>

        @if (isOwner)
        {
            <div style="display: flex; gap: 10px;">
                <button class="btn-main" onclick="openCreateCardModal()">+ Картка</button>
                <button class="btn-main" onclick="openCategoryModal()">+ Категорія</button>
            </div>
        }
    </div>

    <div class="cards-grid">
        @foreach (var card in Model.Flashcards)
        {
            <div class="flashcard-item">
                @if (isOwner)
                {
                    <div class="dots" onclick="toggleMenu(event)">⋮</div>
                    <div class="dropdown">
                        <button type="button" onclick="openEditCardModal('@card.Id', '@card.Term', '@card.Definition')">Редагувати</button>
                        <form asp-controller="Details" asp-action="DeleteCard" method="post" onsubmit="return confirm('Видалити картку?')">
                            <input type="hidden" name="cardId" value="@card.Id" />
                            <input type="hidden" name="setId" value="@Model.Id" />
                            <button type="submit" style="color: #ff8080;">Видалити</button>
                        </form>
                    </div>
                }

                <div class="card-term">@card.Term</div>
                <hr class="card-divider">
                <div class="card-definition">@card.Definition</div>

                <div class="card-update-info">
                    <span style="font-size: 0.65rem; opacity: 0.3;">
                        @if (Model.LastUpdatedAt.Date == DateTime.Today)
                        {
                            <text>Оновлено: @Model.LastUpdatedAt.ToLocalTime().ToString("HH:mm") сьогодні</text>
                        }
                        else
                        {
                            <text>Оновлено: @Model.LastUpdatedAt.ToLocalTime().ToString("dd.MM.yyyy")</text>
                        }
                    </span>
                </div>
            </div>
        }
    </div>
</div>

<!-- МОДАЛКА КАРТКИ -->
<div class="modal-overlay" id="cardModal">
    <div class="modal">
        <h2 id="modalTitle" style="color: var(--accent-color); margin: 0;">Нова картка</h2>
        <form asp-controller="Details" asp-action="SaveCard" method="post">
            <input type="hidden" name="setId" value="@Model.Id" />
            <input type="hidden" name="cardDto.Id" id="modalCardId" value="0" />
            <div style="display: flex; flex-direction: column; gap: 15px; margin-top: 20px;">
                <input type="text" name="cardDto.Term" id="modalTerm" placeholder="Питання" required>
                <textarea name="cardDto.Definition" id="modalDefinition" rows="4" placeholder="Відповідь" required></textarea>
                <div style="display: flex; gap: 10px; justify-content: flex-end;">
                    <button type="button" onclick="closeCardModal()" style="background:none; border:none; color:#818375; cursor:pointer;">Скасувати</button>
                    <button type="submit" class="btn-main">Зберегти</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- МОДАЛКА КАТЕГОРІЙ -->
<div class="modal-overlay" id="categoryModal">
    <div class="modal">
        <h2 style="color: var(--accent-color); margin: 0;">Додати категорію</h2>
        <div class="category-select-list">
            @if (ViewBag.AllCategories != null)
            {
                foreach (var cat in ViewBag.AllCategories as IEnumerable<CategoryDTO>)
                {
                    <div class="category-option">
                        <span onclick="submitAddCategory(@cat.Id)" style="flex-grow:1;">@cat.Name</span>
                        <form asp-controller="Details" asp-action="DeleteCategoryGlobal" method="post" onsubmit="return confirm('Видалити назовсім?')">
                            <input type="hidden" name="setId" value="@Model.Id" />
                            <input type="hidden" name="categoryId" value="@cat.Id" />
                            <button type="submit" style="background:none; border:none; color:#ff8080; cursor:pointer;">✖</button>
                        </form>
                    </div>
                }
            }
        </div>
        <form asp-controller="Details" asp-action="SaveCategory" method="post" id="addCategoryForm">
            <input type="hidden" name="setId" value="@Model.Id" />
            <input type="hidden" name="selectedCategoryId" id="hiddenCatId" value="0" />
            <input type="text" name="newCategoryName" placeholder="Або впишіть нову..." />
            <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 15px;">
                <button type="button" onclick="closeCategoryModal()" style="background:none; border:none; color:#818375; cursor:pointer;">Скасувати</button>
                <button type="submit" class="btn-main">Додати</button>
            </div>
        </form>
    </div>
</div>

<!-- МОДАЛКА РЕДАГУВАННЯ КАТЕГОРІЇ -->
<div class="modal-overlay" id="editCatNameModal">
    <div class="modal">
        <h2 style="color: var(--accent-color); margin: 0;">Редагувати назву</h2>
        <form asp-controller="Details" asp-action="EditCategoryName" method="post">
            <input type="hidden" name="setId" value="@Model.Id" />
            <input type="hidden" name="categoryId" id="editCatId" />
            <input type="text" name="updatedName" id="editCatNameInput" required />
            <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 15px;">
                <button type="button" onclick="closeEditCatModal()" style="background:none; border:none; color:#818375; cursor:pointer;">Скасувати</button>
                <button type="submit" class="btn-main">Оновити</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const catModal = document.getElementById('categoryModal');
        const cardModal = document.getElementById('cardModal');
        const editCatModal = document.getElementById('editCatNameModal');

        function openCategoryModal() { catModal.style.display = 'flex'; }
        function closeCategoryModal() { catModal.style.display = 'none'; }
        function submitAddCategory(id) {
            document.getElementById('hiddenCatId').value = id;
            document.getElementById('addCategoryForm').submit();
        }

        function openEditCategoryModal(id, name) {
            document.getElementById('editCatId').value = id;
            document.getElementById('editCatNameInput').value = name;
            editCatModal.style.display = 'flex';
        }
        function closeEditCatModal() { editCatModal.style.display = 'none'; }

        function openCreateCardModal() {
            document.getElementById('modalTitle').innerText = "Нова картка";
            document.getElementById('modalCardId').value = "0";
            document.getElementById('modalTerm').value = "";
            document.getElementById('modalDefinition').value = "";
            cardModal.style.display = 'flex';
        }

        function openEditCardModal(id, term, def) {
            document.getElementById('modalTitle').innerText = "Редагувати картку";
            document.getElementById('modalCardId').value = id;
            document.getElementById('modalTerm').value = term;
            document.getElementById('modalDefinition').value = def;
            cardModal.style.display = 'flex';
        }

        function closeCardModal() { cardModal.style.display = 'none'; }

        function toggleMenu(e) {
            e.stopPropagation();
            const dropdown = e.currentTarget.nextElementSibling;
            document.querySelectorAll('.dropdown').forEach(d => { if (d !== dropdown) d.style.display = 'none'; });
            dropdown.style.display = dropdown.style.display === 'flex' ? 'none' : 'flex';
        }

        window.addEventListener('click', (e) => {
            if (e.target === catModal) closeCategoryModal();
            if (e.target === cardModal) closeCardModal();
            if (e.target === editCatModal) closeEditCatModal();
            if (!e.target.matches('.dots')) document.querySelectorAll('.dropdown').forEach(d => d.style.display = 'none');
        });
    </script>
}